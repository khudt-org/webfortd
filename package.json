{
  "name": "webfortd",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && npm run sync:content && next build && npm run check:function-trace",
    "start": "next start",
    "lint": "eslint",
    "validate:content": "tsx scripts/validate-frontmatter.ts",
    "sync:content": "tsx scripts/sync-content.ts",
    "kb:sync": "node --env-file=.env.local --import tsx scripts/sync-content-to-db.ts",
    "kb:sync:dry-run": "node --env-file=.env.local --import tsx scripts/sync-content-to-db.ts --dry-run",
    "kb:publish": "node --env-file=.env.local --import tsx scripts/publish-content.ts",
    "kb:publish:dry-run": "node --env-file=.env.local --import tsx scripts/publish-content.ts --dry-run",
    "kb:bootstrap": "node --import tsx scripts/bootstrap-publish.ts --apply",
    "kb:bootstrap:dry-run": "node --import tsx scripts/bootstrap-publish.ts",
    "kb:embed": "node --env-file=.env.local --import tsx scripts/embed-content.ts",
    "kb:embed:dry-run": "node --env-file=.env.local --import tsx scripts/embed-content.ts --dry-run",
    "library:upload": "node --env-file=.env.local --import tsx scripts/upload-library.ts",
    "library:upload:dry-run": "node --env-file=.env.local --import tsx scripts/upload-library.ts --dry-run",
    "image:report": "tsx scripts/image-mappings.ts report",
    "image:template": "tsx scripts/image-mappings.ts template",
    "image:apply": "tsx scripts/image-mappings.ts apply",
    "check:alt-text": "tsx scripts/check-alt-text-labels.ts",
    "check:mdx-escape": "tsx scripts/check-mdx-escape.ts",
    "check:function-trace": "tsx scripts/check-function-trace.ts",
    "test": "node --conditions react-server --import tsx --test 'tests/*.test.ts' 'tests/api/**/*.test.ts' 'tests/auth/**/*.test.ts' 'tests/chat/**/*.test.ts' 'tests/lib/**/*.test.ts' 'tests/library/**/*.test.ts' 'tests/media/**/*.test.ts' 'tests/rag/**/*.test.ts' 'tests/routing/**/*.test.ts' 'tests/scripts/**/*.test.ts' 'tests/voice/**/*.test.ts'",
    "test:integration": "node --env-file=.env.local --import tsx --test 'tests/migrations/**/*.test.ts'",
    "test:components": "vitest --run",
    "test:components:watch": "vitest",
    "test:a11y": "playwright test",
    "test:a11y:ui": "playwright test --ui",
    "test:all": "npm test && npm run test:components && npm run test:integration"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/react": "^3.0.193",
    "@google/genai": "^1.52.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/ssr": "^0.10.3",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "flexsearch": "^0.8.212",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.555.0",
    "nanoid": "^5.1.11",
    "next": "^16.2.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.67.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.4.0",
    "use-stick-to-bottom": "^1.1.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.0.10",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
